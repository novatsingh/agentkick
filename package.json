{
  "name": "agentkick",
  "version": "0.1.0",
  "description": "Prepare repositories with AI-agent instructions, skills, safety rules, and readiness checks for Codex, Claude Code, Cursor, GitHub Copilot, and MCP.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "agentkick": "./dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run typecheck",
    "format": "prettier --write package.json tsconfig.json eslint.config.js tsup.config.mjs \"src/**/*.ts\"",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.js tsup.config.mjs \"src/**/*.ts\"",
    "lint": "eslint .",
    "prepare": "npm run build",
    "smoke": "node dist/index.js --help && node dist/index.js doctor --json",
    "test": "npm run check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "execa": "^9.6.1",
    "fs-extra": "^11.3.5",
    "ora": "^9.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.17",
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0"
  },
  "keywords": [
    "codex",
    "claude-code",
    "cursor",
    "mcp",
    "ai-agents",
    "developer-tools",
    "chrome-extension",
    "ai-saas",
    "marketplace",
    "workflow"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
